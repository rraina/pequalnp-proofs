theorem PEqualNP.Outside.L_meta_8679 : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 5 (fun x : Fin 5 → Bool => Nat.testBit 0xeeeaeac8 (∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 5 → Bool, C.eval (List.ofFn x) = Nat.testBit 0xeeeaeac8 (∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0) := by
  intro s h
  have h' : PEqualNP.MetaComplexity.HasCircuitSize 5 PEqualNP.Outside.L_meta_8679.Check516.graph s := by
    obtain ⟨C, hg, hs, he⟩ := h
    exact ⟨C, hg, hs, fun x => (he x).trans (PEqualNP.Outside.L_meta_8679.Check516.table_graph x)⟩
  have lb := PEqualNP.Outside.L_meta_8679.Check516.lower_of_optimized
    PEqualNP.Outside.L_meta_8679.Check516.no_six s h'
  refine ⟨PEqualNP.Outside.L_meta_8679.Check516.mono7,
    PEqualNP.Outside.L_meta_8679.Check516.mono7_mono, ?_, fun x => ?_⟩
  · exact lb
  · exact (PEqualNP.Outside.L_meta_8679.Check516.mono7_eval x).trans
      (PEqualNP.Outside.L_meta_8679.Check516.table_graph x).symm
